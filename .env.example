# Copy to .env.local for local development. Never commit real values.
# Which Vercel environment (Production = main, Preview = dev + PR previews) each var belongs in:
# see "Environments and deploys" in README.md.

# Override for Vantage's tracked application link (spec §5). Unset = the built-in link in lib/apply.ts.
NEXT_PUBLIC_APPLY_URL=
# Set to "true" only after Vantage confirms extra URL parameters don't break their tracking ID.
NEXT_PUBLIC_APPLY_UTM=false

# Canonical site URL, used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Launch gate (spec §13). Keep "false" until every gate is cleared. Production only.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Show draft guide pages on a non-production build (Vercel preview deployments). Ignored when VERCEL_ENV=production.
SHOW_DRAFTS=false

# Analytics (Plausible). Unset = no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Newsletter (Kit). Unset = signups are logged to the console in development.
KIT_API_KEY=
KIT_FORM_ID=


# Demo deployments: show draft guide pages and a site-wide "Demo preview" banner, even on the
# production URL. Ignored once NEXT_PUBLIC_SITE_INDEXABLE=true. Turn off at launch.
DEMO_MODE=false
